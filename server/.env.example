# Copy this file to .env and fill in real values.
# .env is ignored by git — never commit it.

# Postgres connection string (from Neon: Dashboard -> Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to sign session cookies.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The URL people open in the browser (the frontend).
# Local: http://localhost:5173   Live: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

PORT=3000

# Stripe (Dashboard -> make sure "Test mode" is on -> Developers -> API keys)
STRIPE_SECRET_KEY=sk_test_replace-me

# Signing secret for the webhook (whsec_...).
# Local: printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Live: from the webhook endpoint you add in the Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_replace-me
